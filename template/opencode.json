{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "docs/requirements.md": "deny",
      "docs/coding_rules.md": "deny"
    },
    "bash": {
      "*": "ask",
      "make *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow"
    }
  }
}
