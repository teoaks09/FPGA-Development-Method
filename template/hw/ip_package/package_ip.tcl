# Package one feature as a Vivado custom IP and integration-test it. Args: feature part
source [file join [file dirname [info script]] .. .. flow vivado common.tcl]
lassign $argv feature part

set prefix  [toml_value prefix]
set vendor  [toml_value ip_vendor]
set version [toml_value ip_version]
set top     ${prefix}_${feature}
set ip_dir  [file join $::repo_root build ip $feature]
file delete -force $ip_dir [file join $::repo_root build ip pkg_$feature] [file join $::repo_root build ip test_$feature]

# 1. Package
create_project -force pkg_$feature [file join $::repo_root build ip pkg_$feature] -part $part
foreach list_path [list [file join $::repo_root hw rtl common files.f] [file join $::repo_root hw rtl $feature files.f]] {
    foreach source [dict get [read_file_list $list_path] sources] { add_files -norecurse $source }
}
foreach xdc [glob -nocomplain [file join $::repo_root hw constraints ip ${feature}*.xdc]] {
    add_files -fileset constrs_1 -norecurse $xdc
}
set_property top $top [current_fileset]
update_compile_order -fileset sources_1
ipx::package_project -root_dir $ip_dir -vendor $vendor -library user -taxonomy /UserIP -import_files
set core [ipx::current_core]
set_property name $top $core
set_property version $version $core
set_property display_name $top $core
set_property description "$top (generated by hw/ip_package/package_ip.tcl)" $core
foreach busif [ipx::get_bus_interfaces -of_objects $core] {
    if {[get_property INTERFACE_MODE $busif] ne "monitor" && [string match "*clk*" [get_property NAME $busif]] == 0} {
        catch {ipx::associate_bus_interfaces -busif [get_property NAME $busif] -clock clk $core}
    }
}
set customize [file join $::repo_root hw ip_package ${feature}_customize.tcl]
if {[file exists $customize]} { source $customize }
ipx::create_xgui_files $core
ipx::update_checksums $core
if {[catch {ipx::check_integrity $core} message]} {
    puts $message
    result_line IP FAIL "feature=$feature integrity check failed"
    exit 1
}
ipx::save_core $core
close_project

# 2. Integration test: instantiate in a block design, validate, synthesise out of context
create_project -force test_$feature [file join $::repo_root build ip test_$feature] -part $part
set_property ip_repo_paths [file join $::repo_root build ip] [current_project]
update_ip_catalog
create_bd_design test_bd
set cell [create_bd_cell -type ip -vlnv $vendor:user:$top:$version dut]
make_bd_intf_pins_external [get_bd_intf_pins -quiet -of_objects $cell]
make_bd_pins_external [get_bd_pins -quiet -of_objects $cell -filter {INTF == false}]
if {[catch {validate_bd_design} message]} {
    puts $message
    result_line IP FAIL "feature=$feature block design validation failed"
    exit 1
}
set wrapper [make_wrapper -files [get_files test_bd.bd] -top]
add_files -norecurse $wrapper
set_property top test_bd_wrapper [current_fileset]
generate_target all [get_files test_bd.bd]
synth_design -top test_bd_wrapper -part $part -mode out_of_context
result_line IP PASS "feature=$feature vlnv=$vendor:user:$top:$version"
